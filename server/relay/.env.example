# Copy to .env (git-ignored) for npm run dev: wrangler dev reads it. On Cloudflare it is a secret of the
# worker instead: npx wrangler secret put DISCORD_CLIENT_SECRET
# Developer Portal -> the app -> OAuth2 -> Client Secret
DISCORD_CLIENT_SECRET=

# the development app (its root mapping is the tunnel), if there is one: its client id goes in wrangler.toml
DISCORD_DEV_CLIENT_SECRET=
